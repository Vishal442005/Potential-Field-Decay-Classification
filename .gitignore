# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# LaTeX build artifacts and Paper Files (DO NOT UPLOAD TO GITHUB)
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
PFDC_Manuscript.tex
PFDC_Manuscript.pdf
*.tex
PFDC*.pdf

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Temporary data caches
.pytest_cache/

# Paper documents (DOCX, PDF, TeX)
*.docx
Cover_Letter*.docx

*.pdf
*.zip
elsevier_submission/
tpami_submission/

# Allow tracked updated source in Updated_significant
!Updated_significant/manuscript/*.tex
!Updated_significant/manuscript/*.bbl

# Allow tracked revision sources
!revision/manuscript/*.tex
!revision/manuscript/*.bbl
!revision/manuscript/*.bib
!revision/submission_documents/*.tex
!revision/submission_documents/*.md
